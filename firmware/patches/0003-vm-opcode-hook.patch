     #include "py/vmentrytable.h"
     // CIRCUITPY-CHANGE
@@ -259,6 +265,7 @@ mp_vm_return_kind_t MICROPY_WRAP_MP_EXECUTE_BYTECODE(mp_execute_bytecode)(mp_cod
     #define ONE_TRUE_DISPATCH() one_true_dispatch : do { \
         TRACE(ip); \
         MARK_EXC_IP_GLOBAL(); \
+        MICROPY_VM_HOOK_OPCODE(*ip); \
         goto *(void *)((char *) && entry_MP_BC_LOAD_CONST_FALSE + entry_table[*ip++]); \
 } while (0)
     #define DISPATCH() do { goto one_true_dispatch; } while (0)
@@ -268,6 +275,7 @@ mp_vm_return_kind_t MICROPY_WRAP_MP_EXECUTE_BYTECODE(mp_execute_bytecode)(mp_cod
         TRACE(ip); \
         MARK_EXC_IP_GLOBAL(); \
         TRACE_TICK(ip, sp, false); \
+        MICROPY_VM_HOOK_OPCODE(*ip); \
         goto *entry_table[*ip++]; \
 } while (0)
     #endif
